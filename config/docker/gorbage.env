# gorbage server configuration
# Logging
LOG_LEVEL=info
LOG_FILE=./logs/log.log
LOG_CONSOLE=true
LOG_JSON=true

# TLS
TLS_KEY_PATH=/app/certs/server.key
TLS_CERT_PATH=/app/certs/server.crt
TLS_CA_PATH=/app/certs/ca.crt

# Minio
MINIO_HOST=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_STRONG
MINIO_TOKEN=
MINIO_TIMEOUT=30
MINIO_USE_SSL=false

# Redis
REDIS_HOST=redis:6379
REDIS_PASSWORD=CHANGE_ME_STRONG
REDIS_USER=default
REDIS_DB=0

# Server
UPLOAD_TTL=300
CHUNK_SIZE=8192

# GRPC
ADDRESS=0.0.0.0:8080
TRUSTED_CIDRS=
SERVER_NAME=localhost